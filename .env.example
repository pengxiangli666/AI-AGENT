# OpenAI (used for both tiers; swap model names freely)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_ROUTER=gpt-4o-mini        # cheap tier: planning, review, routing/logic
MODEL_GENERATOR=gpt-4o          # strong tier: code generation

# Checkpointer (PostgresSaver)
POSTGRES_URI=postgresql://agent:agent@localhost:5433/agent?sslmode=disable

# MCP server (SSE / streamable HTTP)
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_URL=http://localhost:8765/sse

# Sandbox
SANDBOX_IMAGE=coding-agent-sandbox:latest
SANDBOX_TIMEOUT=60
FAAS_DOMAIN=localhost
NGINX_CONF_DIR=./deploy/nginx/conf.d

# RAG
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_INDEX_DIR=./data/index
